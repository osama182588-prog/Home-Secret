# Discord Bot Token
DISCORD_TOKEN=your-discord-bot-token

# Discord Application
DISCORD_CLIENT_ID=your-discord-client-id
DISCORD_GUILD_ID=your-guild-id

# Channel IDs
ADMIN_CHANNEL_ID=your-admin-channel-id
LOG_CHANNEL_ID=your-log-channel-id

# Role IDs
VERIFIED_ROLE_ID=your-verified-role-id
UNVERIFIED_ROLE_ID=your-unverified-role-id
REVIEWER_ROLE_ID=your-reviewer-role-id

# Web API
WEB_API_URL=http://localhost:3000
API_SECRET=your-shared-api-secret

# Express Server Port (for webhooks from web)
PORT=3001
